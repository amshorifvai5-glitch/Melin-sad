rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(dateId) {
      return dateId is string && dateId.size() == 10 && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'amshorif.vai5@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidDailyReport(data, dateId) {
      return data.keys().hasAll([
          'dateId', 'ownerUid', 'inTime', 'outTime', 'dutyStatus',
          'basicTasks', 'extraBasicTasks', 'desks', 'breaks',
          'commutes', 'supplies', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateId', 'ownerUid', 'inTime', 'outTime', 'dutyStatus',
          'basicTasks', 'extraBasicTasks', 'desks', 'breaks',
          'commutes', 'supplies', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.dateId is string
        && data.dateId == dateId
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.inTime is string && data.inTime.size() <= 10
        && data.outTime is string && data.outTime.size() <= 10
        && data.dutyStatus is string && data.dutyStatus.size() <= 10
        && data.dutyStatus in ['', 'HQ', 'TS', 'HQ/TS']
        && data.basicTasks is map && data.basicTasks.size() <= 50
        && data.extraBasicTasks is list && data.extraBasicTasks.size() <= 100
        && (data.extraBasicTasks.size() == 0 || data.extraBasicTasks[0] is map)
        && data.desks is map && data.desks.size() <= 80
        && data.breaks is list && data.breaks.size() <= 50
        && (data.breaks.size() == 0 || data.breaks[0] is map)
        && data.commutes is list && data.commutes.size() <= 50
        && (data.commutes.size() == 0 || data.commutes[0] is map)
        && data.supplies is map && data.supplies.size() <= 30
        && data.notes is string && data.notes.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkProof(data, dateId) {
      return data.keys().hasAll([
          'dateId', 'ownerUid', 'isPublic', 'photo', 'description',
          'time', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateId', 'ownerUid', 'isPublic', 'photo', 'description',
          'time', 'createdAt', 'updatedAt'
        ])
        && data.dateId is string && data.dateId == dateId
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.isPublic is bool && data.isPublic == true
        && data.photo is string && data.photo.size() <= 400000
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1000
        && data.time is string && data.time.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProfileSettings(data) {
      return data.keys().hasAll(['ownerUid', 'photoDataUrl', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'photoDataUrl', 'updatedAt'])
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.photoDataUrl is string && data.photoDataUrl.size() <= 350000
        && data.updatedAt is timestamp;
    }

    // Connection check document
    match /test/connection {
      allow get: if true;
    }

    // Admin registry (read-only by self, never writable from client)
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Portal profile avatar settings: everyone can view, only verified owner/admin can edit
    match /portal_settings/profile {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && isValidProfileSettings(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidProfileSettings(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().diff(existing()).affectedKeys().hasOnly(['photoDataUrl', 'updatedAt'])
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Daily reports: everyone can read single date doc, only verified owner/admin can write
    match /daily_reports/{dateId} {
      allow get: if isValidDateId(dateId);
      allow list: if false;

      allow create: if isAdmin()
        && isValidDateId(dateId)
        && isValidDailyReport(incoming(), dateId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidDateId(dateId)
        && isValidDailyReport(incoming(), dateId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().dateId == existing().dateId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'inTime', 'outTime', 'dutyStatus', 'basicTasks',
          'extraBasicTasks', 'desks', 'breaks', 'commutes',
          'supplies', 'notes', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidDateId(dateId);

      // Work proof photos subcollection
      match /proofs/{proofId} {
        allow get: if isValidDateId(dateId) && isValidId(proofId);
        allow list: if isValidDateId(dateId)
          && existing().isPublic == true;

        allow create: if isAdmin()
          && isValidDateId(dateId)
          && isValidId(proofId)
          && isValidWorkProof(incoming(), dateId)
          && incoming().ownerUid == request.auth.uid
          && exists(/databases/$(database)/documents/daily_reports/$(dateId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isAdmin()
          && isValidDateId(dateId)
          && isValidId(proofId)
          && isValidWorkProof(incoming(), dateId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().dateId == existing().dateId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'photo', 'description', 'time', 'updatedAt'
          ]);

        allow delete: if isAdmin() && isValidDateId(dateId) && isValidId(proofId);
      }
    }
  }
}
