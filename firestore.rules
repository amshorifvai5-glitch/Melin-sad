rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateId(dateId) {
      return dateId is string && dateId.size() == 10 && dateId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && (
          request.auth.token.email == 'amshorif.vai5@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidDailyReport(data, dateId) {
      return data.keys().hasAll([
          'dateId', 'ownerUid', 'inTime', 'outTime', 'dutyStatus',
          'basicTasks', 'extraBasicTasks', 'desks', 'breaks',
          'commutes', 'supplies', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateId', 'ownerUid', 'inTime', 'outTime', 'dutyStatus',
          'basicTasks', 'extraBasicTasks', 'desks', 'breaks',
          'commutes', 'supplies', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.dateId is string
        && data.dateId == dateId
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.inTime is string && data.inTime.size() <= 10
        && data.outTime is string && data.outTime.size() <= 10
        && data.dutyStatus is string && data.dutyStatus.size() <= 10
        && data.dutyStatus in ['', 'HQ', 'TS', 'HQ/TS']
        && data.basicTasks is map && data.basicTasks.size() <= 50
        && data.extraBasicTasks is list && data.extraBasicTasks.size() <= 100
        && (data.extraBasicTasks.size() == 0 || data.extraBasicTasks[0] is map)
        && data.desks is map && data.desks.size() <= 80
        && data.breaks is list && data.breaks.size() <= 50
        && (data.breaks.size() == 0 || data.breaks[0] is map)
        && data.commutes is list && data.commutes.size() <= 50
        && (data.commutes.size() == 0 || data.commutes[0] is map)
        && data.supplies is map && data.supplies.size() <= 30
        && data.notes is string && data.notes.size() <= 5000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWorkProof(data, dateId) {
      return data.keys().hasAll([
          'dateId', 'ownerUid', 'isPublic', 'photo', 'description',
          'time', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateId', 'ownerUid', 'isPublic', 'photo', 'description',
          'time', 'createdAt', 'updatedAt'
        ])
        && data.dateId is string && data.dateId == dateId
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.isPublic is bool && data.isPublic == true
        && data.photo is string && data.photo.size() <= 400000
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1000
        && data.time is string && data.time.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProfileSettings(data) {
      return data.keys().hasAll(['ownerUid', 'photoDataUrl', 'updatedAt'])
        && data.keys().hasOnly(['ownerUid', 'photoDataUrl', 'updatedAt'])
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.photoDataUrl is string && data.photoDataUrl.size() <= 350000
        && data.updatedAt is timestamp;
    }

    function isValidFeedback(data, feedbackId) {
      return data.keys().hasAll([
          'feedbackId', 'category', 'senderName', 'message',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'feedbackId', 'category', 'senderName', 'message',
          'status', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && data.feedbackId is string
        && data.feedbackId == feedbackId
        && data.category is string
        && data.category.size() <= 30
        && data.category in ['মতামত', 'পরামর্শ', 'অভিযোগ']
        && data.senderName is string
        && data.senderName.size() <= 100
        && data.message is string
        && data.message.size() >= 1 && data.message.size() <= 2000
        && data.status is string
        && data.status.size() <= 30
        && data.status in ['নতুন', 'দেখা হয়েছে', 'সমাধান হয়েছে']
        && data.adminNote is string
        && data.adminNote.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOfficeExpense(data, dateId) {
      return data.keys().hasAll([
          'dateId', 'ownerUid', 'isPublic', 'title',
          'category', 'amount', 'time', 'note', 'receiptPhoto',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'dateId', 'ownerUid', 'isPublic', 'title',
          'category', 'amount', 'time', 'note', 'receiptPhoto',
          'createdAt', 'updatedAt'
        ])
        && data.dateId is string && data.dateId == dateId
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.isPublic is bool && data.isPublic == true
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.category is string && data.category.size() <= 40
        && data.category in ['চা-নাস্তা', 'যাতায়াত', 'মালামাল ক্রয়', 'অন্যান্য']
        && data.amount is number && data.amount >= 0 && data.amount <= 1000000
        && data.time is string && data.time.size() <= 20
        && data.note is string && data.note.size() <= 500
        && data.receiptPhoto is string && data.receiptPhoto.size() <= 350000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidInventoryItem(data, itemId) {
      return data.keys().hasAll([
          'itemId', 'ownerUid', 'isPublic', 'name',
          'quantity', 'unit', 'note', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'itemId', 'ownerUid', 'isPublic', 'name',
          'quantity', 'unit', 'note', 'createdAt', 'updatedAt'
        ])
        && data.itemId is string && data.itemId == itemId
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.isPublic is bool && data.isPublic == true
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 120
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 100000
        && data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 20
        && data.unit in ['পিস', 'লিটার', 'বোতল', 'বক্স', 'রোল', 'প্যাকেট', 'কেজি']
        && data.note is string && data.note.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLiveLocation(data) {
      return data.keys().hasAll([
          'ownerUid', 'locationLabel', 'note', 'isActive', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUid', 'locationLabel', 'note', 'isActive', 'updatedAt'
        ])
        && data.ownerUid is string
        && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128
        && data.locationLabel is string
        && data.locationLabel.size() >= 1 && data.locationLabel.size() <= 80
        && data.note is string && data.note.size() <= 160
        && data.isActive is bool
        && data.updatedAt is timestamp;
    }

    function isValidSiteVisit(data, visitId) {
      return data.keys().hasAll([
          'visitId', 'dateId', 'visitorToken', 'deviceType',
          'activePage', 'viewsCount', 'createdAt', 'lastSeenAt'
        ])
        && data.keys().hasOnly([
          'visitId', 'dateId', 'visitorToken', 'deviceType',
          'osName', 'browserName', 'screenSize', 'timezone', 'referrerHost',
          'activePage', 'viewsCount', 'createdAt', 'lastSeenAt'
        ])
        && data.visitId is string && data.visitId == visitId
        && data.dateId is string && isValidDateId(data.dateId)
        && data.visitorToken is string
        && data.visitorToken.size() >= 8 && data.visitorToken.size() <= 64
        && data.visitorToken.matches('^[a-zA-Z0-9_\\-]+$')
        && data.visitId == data.dateId + '_' + data.visitorToken
        && data.deviceType is string && data.deviceType.size() <= 20
        && data.deviceType in ['মোবাইল', 'ডেস্কটপ']
        && (!('osName' in data) || (data.osName is string && data.osName.size() <= 30))
        && (!('browserName' in data) || (data.browserName is string && data.browserName.size() <= 30))
        && (!('screenSize' in data) || (data.screenSize is string && data.screenSize.size() <= 24))
        && (!('timezone' in data) || (data.timezone is string && data.timezone.size() <= 60))
        && (!('referrerHost' in data) || (data.referrerHost is string && data.referrerHost.size() <= 100))
        && data.activePage is string
        && data.activePage.size() >= 1 && data.activePage.size() <= 40
        && data.viewsCount is number && data.viewsCount >= 1 && data.viewsCount <= 1000
        && data.createdAt is timestamp
        && data.lastSeenAt is timestamp;
    }

    // Connection check document
    match /test/connection {
      allow get: if true;
    }

    // Admin registry (read-only by self, never writable from client)
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Portal profile avatar settings: everyone can view, only verified owner/admin can edit
    match /portal_settings/profile {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && isValidProfileSettings(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidProfileSettings(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().diff(existing()).affectedKeys().hasOnly(['photoDataUrl', 'updatedAt'])
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Real-time corner location status: everyone can view, only verified owner/admin can edit
    match /portal_settings/live_location {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin()
        && isValidLiveLocation(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidLiveLocation(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'locationLabel', 'note', 'isActive', 'updatedAt'
        ])
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin();
    }

    // Daily reports: everyone can read single date doc, only verified owner/admin can write
    match /daily_reports/{dateId} {
      allow get: if isValidDateId(dateId);
      allow list: if false;

      allow create: if isAdmin()
        && isValidDateId(dateId)
        && isValidDailyReport(incoming(), dateId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidDateId(dateId)
        && isValidDailyReport(incoming(), dateId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().dateId == existing().dateId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'inTime', 'outTime', 'dutyStatus', 'basicTasks',
          'extraBasicTasks', 'desks', 'breaks', 'commutes',
          'supplies', 'notes', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidDateId(dateId);

      // Work proof photos subcollection
      match /proofs/{proofId} {
        allow get: if isValidDateId(dateId) && isValidId(proofId);
        allow list: if isValidDateId(dateId)
          && existing().isPublic == true;

        allow create: if isAdmin()
          && isValidDateId(dateId)
          && isValidId(proofId)
          && isValidWorkProof(incoming(), dateId)
          && incoming().ownerUid == request.auth.uid
          && exists(/databases/$(database)/documents/daily_reports/$(dateId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isAdmin()
          && isValidDateId(dateId)
          && isValidId(proofId)
          && isValidWorkProof(incoming(), dateId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().dateId == existing().dateId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'photo', 'description', 'time', 'updatedAt'
          ]);

        allow delete: if isAdmin() && isValidDateId(dateId) && isValidId(proofId);
      }

      // Office expenses subcollection
      match /expenses/{expenseId} {
        allow get: if isValidDateId(dateId) && isValidId(expenseId);
        allow list: if isValidDateId(dateId)
          && existing().isPublic == true;

        allow create: if isAdmin()
          && isValidDateId(dateId)
          && isValidId(expenseId)
          && isValidOfficeExpense(incoming(), dateId)
          && incoming().ownerUid == request.auth.uid
          && exists(/databases/$(database)/documents/daily_reports/$(dateId))
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isAdmin()
          && isValidDateId(dateId)
          && isValidId(expenseId)
          && isValidOfficeExpense(incoming(), dateId)
          && incoming().ownerUid == existing().ownerUid
          && incoming().dateId == existing().dateId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'title', 'category', 'amount', 'time', 'note', 'receiptPhoto', 'updatedAt'
          ]);

        allow delete: if isAdmin() && isValidDateId(dateId) && isValidId(expenseId);
      }
    }

    // Feedback, suggestions, and complaints: public write-once drop-box, admin-only inbox
    match /feedback/{feedbackId} {
      allow get: if isAdmin() && isValidId(feedbackId);
      allow list: if isAdmin();

      allow create: if isValidId(feedbackId)
        && isValidFeedback(incoming(), feedbackId)
        && incoming().status == 'নতুন'
        && incoming().adminNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(feedbackId)
        && isValidFeedback(incoming(), feedbackId)
        && incoming().feedbackId == existing().feedbackId
        && incoming().category == existing().category
        && incoming().senderName == existing().senderName
        && incoming().message == existing().message
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'adminNote', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(feedbackId);
    }

    // Persistent stock inventory: publicly readable, only verified owner/admin can write
    match /inventory_items/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if existing().isPublic == true;

      allow create: if isAdmin()
        && isValidId(itemId)
        && isValidInventoryItem(incoming(), itemId)
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(itemId)
        && isValidInventoryItem(incoming(), itemId)
        && incoming().ownerUid == existing().ownerUid
        && incoming().itemId == existing().itemId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'quantity', 'unit', 'note', 'updatedAt'
        ]);

      allow delete: if isAdmin() && isValidId(itemId);
    }

    // Anonymous daily visitor presence & page view counter (no PII): admin-only analytics reads
    match /site_visits/{visitId} {
      allow get: if isAdmin() && isValidId(visitId);
      allow list: if isAdmin();

      allow create: if isValidId(visitId)
        && isValidSiteVisit(incoming(), visitId)
        && incoming().viewsCount == 1
        && incoming().createdAt == request.time
        && incoming().lastSeenAt == request.time;

      allow update: if isValidId(visitId)
        && isValidSiteVisit(incoming(), visitId)
        && incoming().visitId == existing().visitId
        && incoming().dateId == existing().dateId
        && incoming().visitorToken == existing().visitorToken
        && incoming().deviceType == existing().deviceType
        && incoming().createdAt == existing().createdAt
        && incoming().lastSeenAt == request.time
        && incoming().viewsCount >= existing().viewsCount
        && incoming().viewsCount <= existing().viewsCount + 1
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'activePage', 'viewsCount', 'lastSeenAt',
          'osName', 'browserName', 'screenSize', 'timezone', 'referrerHost'
        ]);

      allow delete: if isAdmin() && isValidId(visitId);
    }
  }
}
