{
  "entities": {
    "DailyReport": {
      "title": "DailyReport",
      "description": "Daily work report record for a specific calendar date (YYYY-MM-DD).",
      "type": "object",
      "properties": {
        "dateId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "ISO date identifier matching document ID."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the portal owner."
        },
        "inTime": {
          "type": "string",
          "maxLength": 10,
          "description": "Clock-in time in HH:mm format."
        },
        "outTime": {
          "type": "string",
          "maxLength": 10,
          "description": "Clock-out time in HH:mm format."
        },
        "dutyStatus": {
          "type": "string",
          "enum": ["", "HQ", "TS", "HQ/TS", "OFFDAY"],
          "maxLength": 10,
          "description": "Selected duty location or off-day status."
        },
        "basicTasks": {
          "type": "object",
          "description": "Map of basic task IDs to completion state and timestamp."
        },
        "extraBasicTasks": {
          "type": "array",
          "description": "Bounded list of extra tasks completed during the day."
        },
        "desks": {
          "type": "object",
          "description": "Map of desk numbers (1-73) to desk and chair clean flags."
        },
        "breaks": {
          "type": "array",
          "description": "Bounded list of break entries with reason, start, and end times."
        },
        "commutes": {
          "type": "array",
          "description": "Bounded list of office commute log entries."
        },
        "supplies": {
          "type": "object",
          "description": "Map of supply item IDs to refill completion booleans."
        },
        "notes": {
          "type": "string",
          "maxLength": 5000,
          "description": "Daily observations, notes, or issues."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "dateId",
        "ownerUid",
        "inTime",
        "outTime",
        "dutyStatus",
        "basicTasks",
        "extraBasicTasks",
        "desks",
        "breaks",
        "commutes",
        "supplies",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkProof": {
      "title": "WorkProof",
      "description": "Photo proof and description for a completed daily task.",
      "type": "object",
      "properties": {
        "dateId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "isPublic": {
          "type": "boolean"
        },
        "photo": {
          "type": "string",
          "maxLength": 400000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "time": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "dateId",
        "ownerUid",
        "isPublic",
        "photo",
        "description",
        "time",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortalProfileSettings": {
      "title": "PortalProfileSettings",
      "description": "Owner avatar configuration for the public work report portal.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "photoDataUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "photoDataUrl", "updatedAt"]
    },
    "FeedbackSubmission": {
      "title": "FeedbackSubmission",
      "description": "Visitor or colleague feedback, suggestion, or complaint submitted privately to the portal admin.",
      "type": "object",
      "properties": {
        "feedbackId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "category": {
          "type": "string",
          "enum": ["মতামত", "পরামর্শ", "অভিযোগ"],
          "maxLength": 30
        },
        "senderName": {
          "type": "string",
          "maxLength": 100
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["নতুন", "দেখা হয়েছে", "সমাধান হয়েছে"],
          "maxLength": 30
        },
        "adminNote": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "feedbackId",
        "category",
        "senderName",
        "message",
        "status",
        "adminNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "OfficeExpense": {
      "title": "OfficeExpense",
      "description": "Office expense item logged under a specific daily report.",
      "type": "object",
      "properties": {
        "dateId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "isPublic": {
          "type": "boolean"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": ["চা-নাস্তা", "যাতায়াত", "মালামাল ক্রয়", "অন্যান্য"],
          "maxLength": 40
        },
        "amount": {
          "type": "number",
          "description": "Expense amount in BDT."
        },
        "time": {
          "type": "string",
          "maxLength": 20
        },
        "note": {
          "type": "string",
          "maxLength": 500
        },
        "receiptPhoto": {
          "type": "string",
          "maxLength": 350000,
          "description": "Optional compressed receipt or voucher image data URL."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "dateId",
        "ownerUid",
        "isPublic",
        "title",
        "category",
        "amount",
        "time",
        "note",
        "receiptPhoto",
        "createdAt",
        "updatedAt"
      ]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Persistent office stock/inventory record showing available quantity in pieces, liters, or other units.",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "isPublic": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "quantity": {
          "type": "number",
          "description": "Current stock quantity in the specified unit."
        },
        "unit": {
          "type": "string",
          "enum": ["পিস", "লিটার", "বোতল", "বক্স", "রোল", "প্যাকেট", "কেজি"],
          "maxLength": 20
        },
        "note": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "itemId",
        "ownerUid",
        "isPublic",
        "name",
        "quantity",
        "unit",
        "note",
        "createdAt",
        "updatedAt"
      ]
    },
    "LiveLocationStatus": {
      "title": "LiveLocationStatus",
      "description": "Real-time current workplace or area status displayed in the corner widget.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locationLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 160
        },
        "isActive": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "locationLabel", "note", "isActive", "updatedAt"]
    },
    "SiteVisit": {
      "title": "SiteVisit",
      "description": "Anonymous daily browser presence and page view tracking record (no PII) for admin live viewer & visitor analytics.",
      "type": "object",
      "properties": {
        "visitId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "dateId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "visitorToken": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 8,
          "maxLength": 64
        },
        "deviceType": {
          "type": "string",
          "enum": ["মোবাইল", "ডেস্কটপ"],
          "maxLength": 20
        },
        "osName": {
          "type": "string",
          "maxLength": 30
        },
        "browserName": {
          "type": "string",
          "maxLength": 30
        },
        "screenSize": {
          "type": "string",
          "maxLength": 24
        },
        "timezone": {
          "type": "string",
          "maxLength": 60
        },
        "referrerHost": {
          "type": "string",
          "maxLength": 100
        },
        "activePage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "viewsCount": {
          "type": "number",
          "description": "Number of page open events for this anonymous visitor token on dateId."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "visitId",
        "dateId",
        "visitorToken",
        "deviceType",
        "activePage",
        "viewsCount",
        "createdAt",
        "lastSeenAt"
      ]
    }
  },
  "firestore": {
    "/daily_reports/{dateId}": {
      "schema": { "$ref": "#/entities/DailyReport" },
      "description": "Publicly readable daily work reports editable only by the verified owner/admin."
    },
    "/daily_reports/{dateId}/proofs/{proofId}": {
      "schema": { "$ref": "#/entities/WorkProof" },
      "description": "Publicly readable work proof photos belonging to a daily report, editable only by the verified owner/admin."
    },
    "/daily_reports/{dateId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/OfficeExpense" },
      "description": "Publicly readable office expense entries belonging to a daily report, editable only by the verified owner/admin."
    },
    "/portal_settings/profile": {
      "schema": { "$ref": "#/entities/PortalProfileSettings" },
      "description": "Publicly readable portal avatar setting editable only by the verified owner/admin."
    },
    "/portal_settings/live_location": {
      "schema": { "$ref": "#/entities/LiveLocationStatus" },
      "description": "Publicly readable real-time corner location badge editable only by the verified owner/admin."
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/FeedbackSubmission" },
      "description": "Write-once public drop-box for feedback, suggestions, and complaints; readable, updatable, and deletable only by the verified owner/admin."
    },
    "/inventory_items/{itemId}": {
      "schema": { "$ref": "#/entities/InventoryItem" },
      "description": "Publicly readable persistent stock inventory items editable only by the verified owner/admin."
    },
    "/site_visits/{visitId}": {
      "schema": { "$ref": "#/entities/SiteVisit" },
      "description": "Anonymous daily browser session & heartbeat log writable by visitors (strictly bounded, no PII) and readable/deletable only by the verified owner/admin."
    }
  }
}
