{
  "entities": {
    "DailyReport": {
      "title": "DailyReport",
      "description": "Daily work report record for a specific calendar date (YYYY-MM-DD).",
      "type": "object",
      "properties": {
        "dateId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10,
          "description": "ISO date identifier matching document ID."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the portal owner."
        },
        "inTime": {
          "type": "string",
          "maxLength": 10,
          "description": "Clock-in time in HH:mm format."
        },
        "outTime": {
          "type": "string",
          "maxLength": 10,
          "description": "Clock-out time in HH:mm format."
        },
        "dutyStatus": {
          "type": "string",
          "enum": ["", "HQ", "TS", "HQ/TS"],
          "maxLength": 10,
          "description": "Selected duty location."
        },
        "basicTasks": {
          "type": "object",
          "description": "Map of basic task IDs to completion state and timestamp."
        },
        "extraBasicTasks": {
          "type": "array",
          "description": "Bounded list of extra tasks completed during the day."
        },
        "desks": {
          "type": "object",
          "description": "Map of desk numbers (1-73) to desk and chair clean flags."
        },
        "breaks": {
          "type": "array",
          "description": "Bounded list of break entries with reason, start, and end times."
        },
        "commutes": {
          "type": "array",
          "description": "Bounded list of office commute log entries."
        },
        "supplies": {
          "type": "object",
          "description": "Map of supply item IDs to refill completion booleans."
        },
        "notes": {
          "type": "string",
          "maxLength": 5000,
          "description": "Daily observations, notes, or issues."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": [
        "dateId",
        "ownerUid",
        "inTime",
        "outTime",
        "dutyStatus",
        "basicTasks",
        "extraBasicTasks",
        "desks",
        "breaks",
        "commutes",
        "supplies",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkProof": {
      "title": "WorkProof",
      "description": "Photo proof and description for a completed daily task.",
      "type": "object",
      "properties": {
        "dateId": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "minLength": 10,
          "maxLength": 10
        },
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "isPublic": {
          "type": "boolean"
        },
        "photo": {
          "type": "string",
          "maxLength": 400000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "time": {
          "type": "string",
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "dateId",
        "ownerUid",
        "isPublic",
        "photo",
        "description",
        "time",
        "createdAt",
        "updatedAt"
      ]
    },
    "PortalProfileSettings": {
      "title": "PortalProfileSettings",
      "description": "Owner avatar configuration for the public work report portal.",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "photoDataUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerUid", "photoDataUrl", "updatedAt"]
    }
  },
  "firestore": {
    "/daily_reports/{dateId}": {
      "schema": { "$ref": "#/entities/DailyReport" },
      "description": "Publicly readable daily work reports editable only by the verified owner/admin."
    },
    "/daily_reports/{dateId}/proofs/{proofId}": {
      "schema": { "$ref": "#/entities/WorkProof" },
      "description": "Publicly readable work proof photos belonging to a daily report, editable only by the verified owner/admin."
    },
    "/portal_settings/profile": {
      "schema": { "$ref": "#/entities/PortalProfileSettings" },
      "description": "Publicly readable portal avatar setting editable only by the verified owner/admin."
    }
  }
}
